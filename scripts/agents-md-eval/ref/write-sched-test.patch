+    #[test]
+    fn test_decode_runs_beside_long_prefill() {
+        // 7 short requests prefill in one step and each samples a token, so all 7 are decoding.
+        // A 4096-token request then arrives: one 2048-token budget covers 1 decode token per
+        // running request and the long prefill takes the rest (2048 - 7 = 2041).
+        let cfg = SchedulerConfig {
+            max_num_batched_tokens: 2048,
+            max_num_seqs: 16,
+            enable_chunked_prefill: true,
+            long_prefill_token_threshold: 0,
+            ..Default::default()
+        };
+        let mut sched = Scheduler::with_simple_blocks(&cfg, 8192, 4096, 16);
+        let short: Vec<String> = (0..7).map(|i| format!("s{i}")).collect();
+        for id in &short {
+            sched.add_request(make_request(id, 16));
+        }
+        let out = sched.schedule();
+        assert_eq!(out.total_num_scheduled_tokens, 7 * 16);
+        for id in &short {
+            sched.append_output_tokens(id, &[7]);
+        }
+        assert_eq!(sched.get_request_counts(), (7, 0));
+
+        sched.add_request(make_request("long", 4096));
+        let out = sched.schedule();
+        for id in &short {
+            assert_eq!(*out.num_scheduled_tokens.get(id.as_str()).unwrap(), 1);
+        }
+        assert_eq!(*out.num_scheduled_tokens.get("long").unwrap(), 2041);
+        assert_eq!(out.total_num_scheduled_tokens, 2048);
+    }
+
