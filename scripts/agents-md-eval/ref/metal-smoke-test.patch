+// SPDX-License-Identifier: Apache-2.0
+//! AGENTS.md eval smoke test: skips without a Metal 4 GPU, else checks detection.
+
+use scratchy_target_metal::device::{detect_device, metal4_available};
+
+#[test]
+fn amd_smoke() {
+    let Some(dev) = detect_device() else {
+        eprintln!("skipping: no Metal 4 GPU");
+        return;
+    };
+    assert!(metal4_available());
+    drop(dev);
+}
