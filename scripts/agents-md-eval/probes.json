    {
      "id": "metal-skip",
      "group": "child",
      "kind": "answer",
      "scope_dir": "crates/targets/metal",
      "prompt": "Write the first statements a new Metal kernel integration test should use to skip cleanly on a host without a Metal 4 GPU.",
      "answer_format": "ANSWER: <the statements, on one line>",
      "check": {
        "type": "regex_all",
        "patterns": [
          "let Some\\((?!_\\))\\w+\\) = (?:[\\w:]+::)?detect_device\\(\\) else",
          "skipping: no Metal 4 GPU"
        ]
      },
      "key": "ANSWER: let Some(dev) = detect_device() else { eprintln!(\"skipping: no Metal 4 GPU\"); return; };",
      "key_evidence": [
        "crates/targets/metal/tests/affine_gather_qmv_test.rs:180: let Some(mdev) = detect_device() else {",
        "crates/targets/metal/tests/affine_gather_qmv_test.rs:181: eprintln!(\"skipping: no Metal 4 GPU\");",
        "crates/targets/metal/src/lib.rs:319: pub use device::{MetalDevice, detect_device, metal4_available};"
      ]
    },
